# Copy to .env.local and fill in. Never commit real credentials.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hk_leaders

# DataForSEO Basic auth — https://app.dataforseo.com/api-access
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Sandbox by default; production is https://api.dataforseo.com/v3
DATAFORSEO_BASE_URL=https://sandbox.dataforseo.com/v3

# Shared secret appended to the DataForSEO postback URL
POSTBACK_SECRET=change-me
# Public base URL of this app (used to build postback URLs)
APP_URL=http://localhost:3000
# Bearer secret for GET /api/cron/reconcile
CRON_SECRET=change-me
