# Copy to .env.local and fill in. Never commit real credentials.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hk_leaders

# SerpAPI — https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Public base URL of this app
APP_URL=http://localhost:3000
# Still required by the DataForSEO postback and reconcile routes until that code is removed.
POSTBACK_SECRET=change-me
CRON_SECRET=change-me
# Optional: ms a posted task must age before reconcile polls it (default 120000).
# Set to 0 for local sandbox runs where postback cannot reach localhost.
# RECONCILE_MIN_AGE_MS=0

# Optional: LLM operator vs referrer filter (default off). Heuristic referrer rules always run.
# OPERATOR_FILTER_ENABLED=true
# Skip homepage enrichment while testing LLM-only: OPERATOR_FILTER_ENRICH=false
# OPENROUTER_API_KEY=          # preferred; or OPENAI_API_KEY
# LLM_BASE_URL=                # optional; defaults to OpenRouter or OpenAI from the key above
# LLM_MODEL=openai/gpt-4o-mini
# Promote uncertain labels when confidence >= this (default 1 = never promote uncertain)
# OPERATOR_FILTER_UNCERTAIN_MIN_CONFIDENCE=0.85
